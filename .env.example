# Скопируй этот файл:  cp .env.example .env
# Токен: @BotFather → /newbot или /token
BOT_TOKEN=123456789:AAE_paste_your_token_here

# Твои Telegram user id (через запятую). Нужны для /gban /broadcast /leave
# Узнать id: напиши боту @userinfobot
BOT_ADMINS=123456789

DB_PATH=data/moderation_bot.db
DEFAULT_LANG=ru
LOG_LEVEL=INFO
CAPTCHA_TTL=120
RAID_JOINS=10
RAID_WINDOW=12
